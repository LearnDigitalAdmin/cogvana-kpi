{
  "_note": "MERGE these fieldOverrides into the PMS/default-database repo's own firestore.indexes.json and deploy from THAT repo (PAY, PMS and Cyber share this database). Do not deploy this file on its own: `firebase deploy --only firestore:indexes` makes the project match the file. REQUIRED: units.isOccupied and payments.paymentDate (nested two levels, no fallback: PMS KPIs for occupancy and rent collected fail without them; the Firestore error message contains a one-click link). RECOMMENDED: the rest (without them the reader falls back to per-user queries, slower and billed per user document).",
  "fieldOverrides": [
    { "collectionGroup": "units", "fieldPath": "isOccupied", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "payments", "fieldPath": "paymentDate", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "invoices", "fieldPath": "createdAt", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "invoices", "fieldPath": "isPaid", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "invoices", "fieldPath": "billingMonth", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "tenants", "fieldPath": "createdAt", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "tenants", "fieldPath": "isActive", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] },
    { "collectionGroup": "properties", "fieldPath": "createdAt", "indexes": [
      { "order": "ASCENDING", "queryScope": "COLLECTION" },
      { "order": "ASCENDING", "queryScope": "COLLECTION_GROUP" } ] }
  ]
}
