# Copy to .env (never commit .env).

# --- Read by the deployed functions ---
# Source projects the collectors read from (read-only access required).
KPI_SRC_DEFAULT_PROJECT=plot-9fd6e
KPI_SRC_REGISTER_PROJECT=my-register-728ff
KPI_SRC_CHAMA_PROJECT=mychama1
# Same region you chose for the KPI project's Firestore database.
KPI_REGION=us-central1
# Dedicated runtime identity (created in docs/SETUP.md, step 3).
KPI_SERVICE_ACCOUNT=kpi-collector@cogvana-kpi.iam.gserviceaccount.com
