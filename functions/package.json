{
  "name": "samuhia-kpi-functions",
  "private": true,
  "version": "0.1.0",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "deploy": "npm run build && firebase deploy --only functions",
    "dry-run": "npm run build && node lib/scripts/dryRun.js",
    "backfill": "npm run build && node lib/scripts/backfill.js",
    "rollups": "npm run build && node lib/scripts/rollups.js",
    "catalogue": "npm run build && node lib/scripts/catalogue.js"
  },
  "dependencies": {
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
