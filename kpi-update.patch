+      rec("users/u1/sms-sent-log/a", { recipientCount: 10, successCount: 9, failCount: 1, tokensCharged: 9 }),
+      rec("users/u2/sms-sent-log/b", { recipientCount: 1, successCount: 1, failCount: 0, tokensCharged: 1 }),
