+    expect(cr).toHaveLength(1);
+    expect(cr[0]).toMatchObject({ platform: "pms", stream: "reports", netRevenueCents: 19600 });
+  });
+});
+
+describe("revenue-only lines", () => {
+  it("count in revenue but never in attempts or the success rate", async () => {
+    const r = new MemoryPayReader()
+      .add("default", "lmm_payments/LMM_1", { status: "credited", chargeMinor: 20500, surchargeMinor: 500, paystackFeeMinor: 300, keptMinor: 200, createdAt: T_DAY })
+      .add("default", "lmm_payments/LMM_2", { status: "pending", chargeMinor: 1000, createdAt: T_DAY })
+      .add("default", "lmm_settlements/S1", { createdAt: T_DAY, chunks: [{ status: "success", feeMinor: 1000, paystackCostMinor: 600 }] });
+    const store = new MemoryKpiStore();
