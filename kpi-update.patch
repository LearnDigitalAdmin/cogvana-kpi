+import { describe, expect, it } from "vitest";
+import { DAY, DAY_WINDOW, MemoryPayReader, NOW, T_DAY } from "./helpers";
+import { pmsRentAdapter } from "../src/collectors/pay/adapters/rent";
+import { lmmInstalmentAdapter, lmxInstalmentAdapter, lmmSettlementAdapter, lmxTransfersAdapter, lmxWithdrawalsAdapter } from "../src/collectors/pay/adapters/instalments";
+import { landlordWatchAdapter, complianceReportAdapter } from "../src/collectors/pay/adapters/revenueRows";
