+      { title: "WhatsApp usage (exact, needs the usage meter)", ids: ["cyber.wa_users_active", "cyber.wa_messages_in", "cyber.wa_messages_out", "cyber.wa_messages_out_failed", "cyber.wa_delivery_success_rate", "cyber.wa_sessions_started"] },
+      { title: "WhatsApp usage (approximate, available now)", ids: ["cyber.wa_users_seen", "cyber.wa_known_users"] },
+      { title: "House to Rent", ids: ["cyber.house_inquiries_sent", "cyber.house_inquiries_failed", "cyber.house_inquiry_success_rate", "cyber.house_inquiry_credits", "cyber.house_inquiry_managers"] },
+      { title: "Desk agent network", ids: ["cyber.desk_agents_active", "cyber.desk_events", "cyber.desk_gross", "cyber.desk_commission", "cyber.desk_refunds", "cyber.desk_refunded_gross", "cyber.desk_agents_total", "cyber.desk_agents_active_total", "cyber.desk_agents_by_rank", "cyber.desk_customers_total"] },
+      { title: "Coming later", planned: true, ids: ["cyber.shops_total", "cyber.shops_new", "cyber.sales_recorded", "cyber.sales_value", "cyber.expenses_recorded", "cyber.reports_generated", "cyber.report_jobs_failed"] },
+    ],
+  },
+};
+export const PAY_SECTION_TITLE = MONEY_FROM_PAY;
+
+type Fb = [id: string, name: string, type: KpiDefinition["type"], unit: KpiDefinition["unit"], direction: KpiDefinition["direction"], grains: KpiDefinition["grains"]];
+const ALL: KpiDefinition["grains"] = ["daily", "weekly", "monthly"];
+const FALLBACKS: Fb[] = [
+  ["company.active_accounts", "Active accounts", "flow", "count", "higher_is_better", ALL],
+  ["company.new_accounts", "New accounts", "flow", "count", "higher_is_better", ALL],
+  ["company.net_revenue_per_active_account", "Net revenue per active account", "ratio", "KES_CENTS", "higher_is_better", ["weekly", "monthly"]],
+  ["company.unverified_revenue_share", "Unverified revenue share", "ratio", "percent", "lower_is_better", ALL],
+  ["company.data_freshness_max_hours", "Oldest data (hours)", "stock", "hours", "lower_is_better", ["daily"]],
+  ["company.collectors_stale", "Collectors stale", "stock", "count", "lower_is_better", ["daily"]],
+  ["cross.revenue_share", "Revenue share by platform", "ratio", "percent", "neutral", ALL],
+  ["cross.stream_share", "Revenue share by stream", "ratio", "percent", "neutral", ALL],
+  ["cross.subscription_revenue", "Subscription revenue (recurring)", "flow", "KES_CENTS", "higher_is_better", ALL],
+  ["cross.sms_units_used", "SMS units used", "flow", "count", "neutral", ALL],
+  ["cross.sms_prepaid_outstanding", "Prepaid SMS units outstanding", "stock", "count", "neutral", ALL],
+  ["cross.sms_cost_estimate", "SMS provider cost (estimate)", "flow", "KES_CENTS", "lower_is_better", ALL],
+  ["cross.sms_margin", "SMS margin (estimate)", "flow", "KES_CENTS", "higher_is_better", ALL],
+  ["cross.digital_rent_share", "Digital rent share", "ratio", "percent", "higher_is_better", ALL],
+];
+
+/** Used only when a definition document is missing from kpi_definitions (e.g. parallel work not deployed yet). */
+export const FALLBACK_DEFS = new Map<string, KpiDefinition>(FALLBACKS.map(([id, name, type, unit, direction, grains]) => [id, {
+  id, name, description: "", scope: id.startsWith("cross.") ? "cross" : "company", platform: "all", type, unit, grain: grains[0], grains,
+  formula: "", direction, dimensions: [], thresholds: {}, owner: "", decision: "", version: 1, status: "active",
+} satisfies KpiDefinition]));
+
+export function placeholderDef(id: string): KpiDefinition {
+  const fb = FALLBACK_DEFS.get(id);
+  if (fb) return fb;
+  const raw = id.split(".").slice(1).join(" ").replace(/_/g, " ");
+  return {
+    id, name: raw.charAt(0).toUpperCase() + raw.slice(1) || id, description: "", scope: "platform", platform: "all", type: "flow", unit: "count",
+    grain: "daily", grains: ["daily"], formula: "", direction: "neutral", dimensions: [], thresholds: {}, owner: "", decision: "", version: 1, status: "active",
+  };
+}
+
+export function normaliseDefinition(id: string, d: Partial<KpiDefinition>): KpiDefinition {
+  const base = placeholderDef(id);
+  const grain = d.grain ?? base.grain;
+  return {
+    ...base, ...d, id,
+    name: d.name || base.name,
+    grain,
+    grains: d.grains && d.grains.length ? d.grains : [grain],
+    dimensions: d.dimensions ?? [],
+    thresholds: d.thresholds ?? {},
+    status: d.status ?? "active",
+    direction: d.direction ?? "neutral",
+  };
+}
diff --git a/dashboard/src/lib/nairobi.test.ts b/dashboard/src/lib/nairobi.test.ts
new file mode 100644
index 0000000..04c0103
--- /dev/null
+++ b/dashboard/src/lib/nairobi.test.ts
@@ -0,0 +1,52 @@
+import { describe, expect, it } from "vitest";
+import { addDays, addMonths, expectedPeriods, formatClock, formatDay, periodLabel, presetsFor, previousRange, rangeLength, startOfWeek, todayNairobi, validateRange } from "./nairobi";
+
+describe("nairobi", () => {
+  it("today rolls over at 21:00 UTC (00:00 Nairobi)", () => {
+    expect(todayNairobi(Date.UTC(2026, 8, 29, 20, 59))).toBe("2026-09-29");
+    expect(todayNairobi(Date.UTC(2026, 8, 29, 21, 0))).toBe("2026-09-30");
+  });
+  it("labels", () => {
+    expect(formatDay("2026-09-29")).toBe("Tue 29 Sep");
+    expect(periodLabel("weekly", "2026-09-28")).toBe("Week of 28 Sep");
+    expect(periodLabel("monthly", "2026-09-01")).toBe("Sep 2026");
+    expect(formatClock(Date.UTC(2026, 8, 29, 21, 5))).toBe("00:05");
+  });
+  it("daily presets across month boundaries", () => {
+    const p = Object.fromEntries(presetsFor("daily", "2026-03-02").map((x) => [x.id, x]));
+    expect(p["7d"]).toMatchObject({ from: "2026-02-24", to: "2026-03-02" });
+    expect(p["this-month"]).toMatchObject({ from: "2026-03-01", to: "2026-03-02" });
+    expect(p["last-month"]).toMatchObject({ from: "2026-02-01", to: "2026-02-28" });
+  });
+  it("handles 29 Feb", () => {
+    expect(addDays("2028-02-28", 1)).toBe("2028-02-29");
+    expect(addDays("2028-02-29", 1)).toBe("2028-03-01");
+    const p = presetsFor("daily", "2028-03-10").find((x) => x.id === "last-month")!;
+    expect(p).toMatchObject({ from: "2028-02-01", to: "2028-02-29" });
+    expect(addMonths("2028-03-31", -1)).toBe("2028-02-01");
+  });
+  it("weekly and monthly presets", () => {
+    expect(startOfWeek("2026-10-04")).toBe("2026-09-28"); // Sunday → previous Monday
+    const w = presetsFor("weekly", "2026-10-02")[0];
+    expect(w).toMatchObject({ from: "2026-08-10", to: "2026-10-02" });
+    const m = presetsFor("monthly", "2026-01-15")[0];
+    expect(m).toMatchObject({ from: "2025-08-01", to: "2026-01-15" });
+  });
+  it("previous range is equal length and adjacent", () => {
+    expect(previousRange("2026-09-24", "2026-09-30")).toEqual({ from: "2026-09-17", to: "2026-09-23" });
+    expect(rangeLength("2026-09-24", "2026-09-30")).toBe(7);
+  });
+  it("validates ranges", () => {
+    const t = "2026-10-02";
+    expect(validateRange("2026-09-01", "2026-09-30", t)).toBeNull();
+    expect(validateRange("2026-09-30", "2026-09-01", t)).toMatch(/before/);
+    expect(validateRange("2026-09-01", "2026-10-03", t)).toMatch(/future/);
+    expect(validateRange("2025-01-01", "2026-10-02", t)).toMatch(/400/);
+    expect(validateRange("nope", "2026-10-02", t)).toMatch(/valid/);
+  });
+  it("expected periods per grain", () => {
+    expect(expectedPeriods("daily", "2026-09-29", "2026-10-01")).toEqual(["2026-09-29", "2026-09-30", "2026-10-01"]);
+    expect(expectedPeriods("weekly", "2026-09-29", "2026-10-13")).toEqual(["2026-10-05", "2026-10-12"]);
+    expect(expectedPeriods("monthly", "2026-08-15", "2026-10-02")).toEqual(["2026-09-01", "2026-10-01"]);
+  });
+});
diff --git a/dashboard/src/lib/nairobi.ts b/dashboard/src/lib/nairobi.ts
new file mode 100644
index 0000000..a32117f
--- /dev/null
+++ b/dashboard/src/lib/nairobi.ts
@@ -0,0 +1,128 @@
+import type { Grain } from "./types";
+
+const DAY_MS = 86_400_000;
+const DOW = ["Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat"];
+const MON = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
+
+export const MAX_RANGE_DAYS = 400;
+
+/** Africa/Nairobi is UTC+3 with no DST. Never use the browser's timezone for period logic. */
+export function todayNairobi(now: number = Date.now()): string {
+  return new Date(now + 3 * 3600 * 1000).toISOString().slice(0, 10);
+}
+
+export function toUtc(iso: string): number {
+  const [y, m, d] = iso.split("-").map(Number);
+  return Date.UTC(y, m - 1, d);
+}
+export function fromUtc(ms: number): string {
+  return new Date(ms).toISOString().slice(0, 10);
+}
+export function isIsoDay(s: string | null | undefined): s is string {
+  if (!s || !/^\d{4}-\d{2}-\d{2}$/.test(s)) return false;
+  return fromUtc(toUtc(s)) === s;
+}
+export function addDays(iso: string, n: number): string {
+  return fromUtc(toUtc(iso) + n * DAY_MS);
+}
+/** b - a in whole days. */
+export function diffDays(a: string, b: string): number {
+  return Math.round((toUtc(b) - toUtc(a)) / DAY_MS);
+}
+/** Monday of the week containing `iso`. */
+export function startOfWeek(iso: string): string {
+  const dow = new Date(toUtc(iso)).getUTCDay();
+  return addDays(iso, -((dow + 6) % 7));
+}
+export function startOfMonth(iso: string): string {
+  return iso.slice(0, 8) + "01";
+}
+/** First day of the month `n` months from the month of `iso`. */
+export function addMonths(iso: string, n: number): string {
+  const [y, m] = iso.split("-").map(Number);
+  return fromUtc(Date.UTC(y, m - 1 + n, 1));
+}
+export function endOfMonth(iso: string): string {
+  return addDays(addMonths(iso, 1), -1);
+}
+
+export interface Range { from: string; to: string }
+export interface Preset extends Range { id: string; label: string }
+
+export function presetsFor(grain: Grain, today: string): Preset[] {
+  if (grain === "daily") {
+    const lastMonthStart = addMonths(today, -1);
+    return [
+      { id: "7d", label: "Last 7 days", from: addDays(today, -6), to: today },
+      { id: "30d", label: "Last 30 days", from: addDays(today, -29), to: today },
+      { id: "90d", label: "Last 90 days", from: addDays(today, -89), to: today },
+      { id: "this-month", label: "This month", from: startOfMonth(today), to: today },
+      { id: "last-month", label: "Last month", from: lastMonthStart, to: endOfMonth(lastMonthStart) },
+    ];
+  }
+  if (grain === "weekly") {
+    const monday = startOfWeek(today);
+    return [8, 12, 26].map((n) => ({ id: `${n}w`, label: `Last ${n} weeks`, from: addDays(monday, -7 * (n - 1)), to: today }));
+  }
+  const first = startOfMonth(today);
+  return [6, 12].map((n) => ({ id: `${n}m`, label: `Last ${n} months`, from: addMonths(first, -(n - 1)), to: today }));
+}
+
+export function defaultPreset(grain: Grain, today: string): Preset {
+  return presetsFor(grain, today)[0];
+}
+
+export function rangeLength(from: string, to: string): number {
+  return diffDays(from, to) + 1;
+}
+
+/** The equal-length range that ends the day before `from`. */
+export function previousRange(from: string, to: string): Range {
+  const len = rangeLength(from, to);
+  return { from: addDays(from, -len), to: addDays(from, -1) };
+}
+
+export function validateRange(from: string, to: string, today: string): string | null {
+  if (!isIsoDay(from) || !isIsoDay(to)) return "Enter valid dates.";
+  if (from > to) return "Start date must be on or before the end date.";
+  if (to > today) return "End date cannot be in the future.";
+  if (rangeLength(from, to) > MAX_RANGE_DAYS) return `Range is limited to ${MAX_RANGE_DAYS} days.`;
+  return null;
+}
+
+/** periodStart values a grain can produce inside [from, to] (used to leave gaps for absent periods). */
+export function expectedPeriods(grain: Grain, from: string, to: string): string[] {
+  const out: string[] = [];
+  if (from > to) return out;
+  if (grain === "daily") {
+    for (let d = from; d <= to; d = addDays(d, 1)) out.push(d);
+  } else if (grain === "weekly") {
+    let d = startOfWeek(from);
+    if (d < from) d = addDays(d, 7);
+    for (; d <= to; d = addDays(d, 7)) out.push(d);
+  } else {
+    let d = startOfMonth(from);
+    if (d < from) d = addMonths(d, 1);
+    for (; d <= to; d = addMonths(d, 1)) out.push(d);
+  }
+  return out;
+}
+
+/** `Tue 29 Sep` */
+export function formatDay(iso: string): string {
+  const dt = new Date(toUtc(iso));
+  return `${DOW[dt.getUTCDay()]} ${dt.getUTCDate()} ${MON[dt.getUTCMonth()]}`;
+}
+
+/** daily `Tue 29 Sep`, weekly `Week of 28 Sep`, monthly `Sep 2026` */
+export function periodLabel(grain: Grain, periodStart: string): string {
+  const dt = new Date(toUtc(periodStart));
+  if (grain === "daily") return formatDay(periodStart);
+  if (grain === "weekly") return `Week of ${dt.getUTCDate()} ${MON[dt.getUTCMonth()]}`;
+  return `${MON[dt.getUTCMonth()]} ${dt.getUTCFullYear()}`;
+}
+
+/** HH:MM in Nairobi time. */
+export function formatClock(ms: number): string {
+  return new Date(ms + 3 * 3600 * 1000).toISOString().slice(11, 16);
+}
