+import { describe, expect, it } from "vitest";
+import { formatCount, formatDelta, formatHours, formatMoney, formatPercent, formatValue } from "./format";
+
+describe("format", () => {
+  it("money: cents to KES, decimals only below 1,000", () => {
+    expect(formatMoney(12500)).toBe("KES 125.00");
+    expect(formatMoney(123456789)).toBe("KES 1,234,568");
+    expect(formatMoney(100000)).toBe("KES 1,000");
+    expect(formatMoney(99999)).toBe("KES 999.99");
+    expect(formatMoney(-250000)).toBe("-KES 2,500");
+  });
+  it("money: compact form for tiles", () => {
+    expect(formatMoney(120_000_000, { compact: true })).toBe("KES 1.2M");
+    expect(formatMoney(1_250_000, { compact: true })).toBe("KES 12.5K");
+    expect(formatMoney(12500, { compact: true })).toBe("KES 125.00");
+  });
+  it("percent: one decimal", () => {
+    expect(formatPercent(66.666)).toBe("66.7%");
+    expect(formatPercent(0)).toBe("0.0%");
+  });
+  it("count: grouped, compact only above 100,000", () => {
+    expect(formatCount(1234567)).toBe("1,234,567");
+    expect(formatCount(100000, { compact: true })).toBe("100,000");
+    expect(formatCount(150000, { compact: true })).toBe("150K");
+    expect(formatCount(1_200_000, { compact: true })).toBe("1.2M");
+  });
+  it("hours", () => expect(formatHours(3.24)).toBe("3.2 h"));
+  it("absent values render as a dash, never 0", () => {
+    expect(formatValue("count", null)).toBe("—");
+    expect(formatValue("KES_CENTS", undefined)).toBe("—");
+    expect(formatValue("count", 0)).toBe("0");
+  });
+  it("delta", () => {
+    expect(formatDelta(-12.345)).toBe("12.3%");
+    expect(formatDelta(250.4)).toBe("250%");
+  });
+});
diff --git a/dashboard/src/lib/format.ts b/dashboard/src/lib/format.ts
new file mode 100644
index 0000000..e737eb3
--- /dev/null
+++ b/dashboard/src/lib/format.ts
@@ -0,0 +1,59 @@
+import type { KpiUnit } from "./types";
+
+const DASH = "—";
+
+function group(n: number): string {
+  return Math.round(n).toLocaleString("en-US");
+}
+function trim1(n: number): string {
+  return n.toFixed(1).replace(/\.0$/, "");
+}
+function compactNumber(abs: number): string {
+  if (abs >= 1e9) return `${trim1(abs / 1e9)}B`;
+  if (abs >= 1e6) return `${trim1(abs / 1e6)}M`;
+  if (abs >= 1e3) return `${trim1(abs / 1e3)}K`;
+  return group(abs);
+}
+
+/** Integer cents → `KES 1,234,567` (no decimals from KES 1,000; two below). Compact: `KES 1.2M`. */
+export function formatMoney(cents: number, opts: { compact?: boolean } = {}): string {
+  if (!Number.isFinite(cents)) return DASH;
+  const kes = cents / 100;
+  const sign = kes < 0 ? "-" : "";
+  const abs = Math.abs(kes);
+  if (opts.compact && abs >= 1000) return `${sign}KES ${compactNumber(abs)}`;
+  if (abs >= 1000) return `${sign}KES ${group(abs)}`;
+  return `${sign}KES ${abs.toFixed(2)}`;
+}
+
+export function formatPercent(v: number): string {
+  return Number.isFinite(v) ? `${v.toFixed(1)}%` : DASH;
+}
+
+/** Grouped integer; compact (`1.2M`, `150K`) only above 100,000 when `compact` is set. */
+export function formatCount(v: number, opts: { compact?: boolean } = {}): string {
+  if (!Number.isFinite(v)) return DASH;
+  const sign = v < 0 ? "-" : "";
+  const abs = Math.abs(v);
+  if (opts.compact && abs > 100_000) return `${sign}${compactNumber(abs)}`;
+  return `${sign}${group(abs)}`;
+}
+
+export function formatHours(v: number): string {
+  return Number.isFinite(v) ? `${v.toFixed(1)} h` : DASH;
+}
+
+export function formatValue(unit: KpiUnit, v: number | null | undefined, opts: { compact?: boolean } = {}): string {
+  if (v === null || v === undefined || !Number.isFinite(v)) return DASH;
+  switch (unit) {
+    case "KES_CENTS": return formatMoney(v, opts);
+    case "percent": return formatPercent(v);
+    case "hours": return formatHours(v);
+    default: return formatCount(v, opts);
+  }
+}
+
+export function formatDelta(pct: number): string {
+  const abs = Math.abs(pct);
+  return `${abs >= 100 ? abs.toFixed(0) : abs.toFixed(1)}%`;
+}
