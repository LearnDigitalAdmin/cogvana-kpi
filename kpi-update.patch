@@ -0,0 +1,104 @@
+import { DocRecord, SourceReader } from "../../core/reader";
+import { Metric } from "../../core/values";
+import { num, pct, toCents } from "../../core/money";
+
+/**
+ * DESK network and House to Rent. Collections in the shared default database, all written by PAY / DESK:
+ *  - desk_events/{id}: one fact per desk-attributed payment (paidAt epoch ms, grossMinor, feeMinor, agentSharePct, product, type, agentId)
+ *  - desk_agents/{uid}: agentCode, status, rank (clerk | senior | lead | admin | internal)
+ *  - desk_customers/{entityKey}: customers attributed to a desk agent
+ *  - houseInquiries/{id}: one document per House to Rent inquiry that reached the SMS provider (createdAt Timestamp)
+ * Agent ids and owner codes are pseudonymous business identifiers and are only counted; phones, names and message text are never selected.
+ */
+export const DESK_EVENT_SELECT = ["type", "product", "agentId", "grossMinor", "feeMinor", "agentSharePct"];
+export const INQUIRY_SELECT = ["status", "credits", "ownerId"];
+export const DESK_RANKS = ["clerk", "senior", "lead", "admin", "internal"] as const;
+export const DESK_PRODUCTS = ["chama", "school", "pms"] as const;
+
+/** Commission the agent earned on an event: share % of what was left after the Paystack fee (derived; the split itself is on Paystack). */
+export function commissionCents(gross: number, fee: number, pctShare: number): number {
+  return Math.round(((gross - fee) * pctShare) / 100);
+}
+
+export interface DeskRow {
+  agentId: string | null;
+  product: string;
+  refund: boolean;
+  grossCents: number;
+  commissionCents: number;
+}
+
+export function toDeskRow(rec: DocRecord): DeskRow {
+  const d = rec.data;
+  const gross = Math.round(num(d.grossMinor) ?? 0);
+  const fee = Math.round(num(d.feeMinor) ?? 0);
+  return {
+    agentId: typeof d.agentId === "string" && d.agentId ? d.agentId : null,
+    product: typeof d.product === "string" ? d.product : "",
+    refund: d.type === "refund",
+    grossCents: gross,
+    commissionCents: commissionCents(gross, fee, num(d.agentSharePct) ?? 0),
+  };
+}
+
+/** Totals plus a per-product breakdown; refunds are counted separately and excluded from gross and commission. */
+export function deskMetrics(rows: DeskRow[]): { total: Record<string, Metric>; byProduct: Record<string, Record<string, Metric>> } {
+  const sales = rows.filter((r) => !r.refund);
+  const sum = (rs: DeskRow[], pick: (r: DeskRow) => number) => rs.reduce((t, r) => t + pick(r), 0);
+  const metrics = (rs: DeskRow[]): Record<string, Metric> => ({
+    "cyber.desk_events": { value: rs.length },
+    "cyber.desk_gross": { value: sum(rs, (r) => r.grossCents) },
+    "cyber.desk_commission": { value: sum(rs, (r) => r.commissionCents) },
+  });
+  const byProduct: Record<string, Record<string, Metric>> = {};
+  for (const product of DESK_PRODUCTS) byProduct[product] = metrics(sales.filter((r) => r.product === product));
+  const refunds = rows.filter((r) => r.refund);
+  return {
+    total: { ...metrics(sales), "cyber.desk_refunds": { value: refunds.length }, "cyber.desk_refunded_gross": { value: sum(refunds, (r) => r.grossCents) } },
+    byProduct,
+  };
+}
+
+export function activeAgents(rows: DeskRow[]): Set<string> {
+  const out = new Set<string>();
+  for (const r of rows) if (!r.refund && r.agentId) out.add(r.agentId);
+  return out;
+}
+
+export function inquiryMetrics(docs: DocRecord[]): { metrics: Record<string, Metric>; managers: number } {
+  let sent = 0;
+  let failed = 0;
+  let credits = 0;
+  const owners = new Set<string>();
+  for (const d of docs) {
+    const status = typeof d.data.status === "string" ? d.data.status : "";
+    if (status === "sent") {
+      sent++;
+      credits += num(d.data.credits) ?? 0;
+      if (typeof d.data.ownerId === "string" && d.data.ownerId) owners.add(d.data.ownerId);
+    } else if (status === "failed") failed++;
+  }
+  return {
+    metrics: {
+      "cyber.house_inquiries_sent": { value: sent },
+      "cyber.house_inquiries_failed": { value: failed },
+      "cyber.house_inquiry_credits": { value: credits },
+      "cyber.house_inquiry_success_rate": { value: pct(sent, sent + failed), numerator: sent, denominator: sent + failed },
+    },
+    managers: owners.size,
+  };
+}
+
+/** Stock counts for the desk network (aggregates only; no documents read). */
+export async function deskStock(reader: SourceReader): Promise<{ byRank: Record<string, number>; total: number; active: number; customers: number }> {
+  const src = "default" as const;
+  const [ranks, total, active, customers] = await Promise.all([
+    Promise.all(DESK_RANKS.map((r) => reader.count({ source: src, collection: "desk_agents", equals: { field: "rank", value: r } }))),
+    reader.count({ source: src, collection: "desk_agents" }),
+    reader.count({ source: src, collection: "desk_agents", equals: { field: "status", value: "active" } }),
+    reader.count({ source: src, collection: "desk_customers" }),
+  ]);
+  return { byRank: Object.fromEntries(DESK_RANKS.map((r, i) => [r, ranks[i]])), total, active, customers };
+}
+
+export { toCents };
