@@ -0,0 +1,36 @@
+import { DocRecord } from "../../core/reader";
+import { Metric } from "../../core/values";
+import { num, pct } from "../../core/money";
+
+/**
+ * users/{userId}/sms-sent-log: one audit entry per bulk SMS send (written by the Plot Yangu app / WhatsApp service and by DESK for
+ * House to Rent). Message text, phone numbers and property ids are never selected. A collection-group query also matches any other
+ * collection named sms-sent-log, so rows are accepted only at users/{userId}/sms-sent-log/{id}.
+ */
+export const SMS_LOG_SELECT = ["recipientCount", "tokensCharged", "successCount", "failCount"];
+
+export function isUserSmsLog(path: string): boolean {
+  const p = path.split("/");
+  return p.length === 4 && p[0] === "users" && p[2] === "sms-sent-log" && !!p[1];
+}
+
+export function smsLogMetrics(docs: DocRecord[]): Record<string, Metric> {
+  let ok = 0;
+  let failed = 0;
+  let tokens = 0;
+  let messages = 0;
+  for (const d of docs) {
+    if (!isUserSmsLog(d.path)) continue;
+    messages++;
+    ok += num(d.data.successCount) ?? 0;
+    failed += num(d.data.failCount) ?? 0;
+    tokens += num(d.data.tokensCharged) ?? 0;
+  }
+  return {
+    "pms.sms_messages": { value: messages },
+    "pms.sms_recipients_ok": { value: ok },
+    "pms.sms_recipients_failed": { value: failed },
+    "pms.sms_tokens_charged": { value: tokens },
+    "pms.sms_success_rate": { value: pct(ok, ok + failed), numerator: ok, denominator: ok + failed },
+  };
+}
