+    const vals = [...store.values.values()];
+    const pms = (id: string, dims: Record<string, string> = {}) => vals.find((v) => v.kpiId === id && v.platform === "pms" && JSON.stringify(v.dimensions) === JSON.stringify(dims))!;
+    expect(pms("pay.attempts").value).toBe(2); // the two instalments, not the settlement
+    expect(pms("pay.success_rate")).toMatchObject({ value: 50, numerator: 1, denominator: 2 });
+    expect(pms("pay.net_revenue").value).toBe(600); // 200 instalment + 400 settlement margin
+    expect(pms("pay.net_revenue", { stream: "instalments" }).value).toBe(200);
+    expect(pms("pay.net_revenue", { stream: "transfers" }).value).toBe(400);
+    expect(vals.find((v) => v.kpiId === "company.net_revenue" && v.platform === "all" && Object.keys(v.dimensions).length === 0)!.value).toBe(600);
+  });
+
+  it("aggregation works on facts directly", () => {
+    const ctx = { period: dailyPeriod(DAY), runId: "t", now: NOW, stuckMs: 1800000 };
+    expect(aggregateFacts([], ctx).length).toBeGreaterThan(0);
+  });
+});
+
+describe("Plot Yangu SMS audit log and credits", () => {
