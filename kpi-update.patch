index 0000000..ea568d3
--- /dev/null
+++ b/functions/src/collectors/pay/adapters/revenueRows.ts
@@ -0,0 +1,42 @@
+import { PayAdapter } from "./types";
+import { ChargeType, PaymentFact, STREAM_BY_CHARGE_TYPE, PLATFORM_BY_CHARGE_TYPE } from "../facts";
+import { num, toCents } from "../../../core/money";
+import { toMillis } from "../../../core/timestamps";
+
+/**
+ * Products that PAY books straight into `platform_revenue` when the payment succeeds (no separate attempt record is
+ * read here), so they enter as revenue-only lines: GMV, fees and revenue, but not attempts or success rate.
+ *   landlord_watch_transcript : Landlord Watch extra transcripts (KES 99), type "landlord_watch_transcript"
+ *   compliance_report         : compliance reports (KES 200), type "compliance_report"
+ * `platform_revenue` holds decimal KES: grossAmount, paystackFees, netRevenue.
+ */
+function adapterFor(id: ChargeType, revenueType: string): PayAdapter {
+  return {
+    id,
+    platform: PLATFORM_BY_CHARGE_TYPE[id],
+    async load(reader, w) {
+      const docs = await reader.queryRange({
+        source: "default", collection: "platform_revenue", timeField: "createdAt", timeType: "timestamp", startMs: w.startMs, endMs: w.endMs,
+        select: ["type", "grossAmount", "paystackFees", "netRevenue", "createdAt"],
+      });
+      const facts: PaymentFact[] = [];
+      for (const rec of docs) {
+        if (rec.data.type !== revenueType) continue;
+        const createdAtMs = toMillis(rec.data.createdAt);
+        if (createdAtMs === null) continue;
+        const gross = toCents(num(rec.data.grossAmount) ?? 0);
+        const fee = toCents(num(rec.data.paystackFees) ?? 0);
+        const net = rec.data.netRevenue !== undefined ? toCents(num(rec.data.netRevenue) ?? 0) : gross - fee;
+        facts.push({
+          reference: rec.id, chargeType: id, platform: PLATFORM_BY_CHARGE_TYPE[id], stream: STREAM_BY_CHARGE_TYPE[id], status: "success",
+          createdAtMs, settledAtMs: createdAtMs, gmvCents: gross, gatewayFeeCents: fee, platformRevenueCents: gross, passThroughCents: 0,
+          netRevenueCents: net, basis: "recorded", customerRef: null, revenueOnly: true,
+        });
+      }
+      return facts;
+    },
+  };
+}
+
+export const landlordWatchAdapter = adapterFor("landlord_watch_transcript", "landlord_watch_transcript");
+export const complianceReportAdapter = adapterFor("compliance_report", "compliance_report");
