diff --git a/functions/src/collectors/pay/adapters/instalments.ts b/functions/src/collectors/pay/adapters/instalments.ts
new file mode 100644
index 0000000..abf558c
--- /dev/null
+++ b/functions/src/collectors/pay/adapters/instalments.ts
@@ -0,0 +1,155 @@
+import { PayAdapter } from "./types";
+import { PaymentFact, STREAM_BY_CHARGE_TYPE, get, statusOf } from "../facts";
+import { num } from "../../../core/money";
+import { toMillis } from "../../../core/timestamps";
+import { DocRecord } from "../reader";
+
+/**
+ * Lipa Mos Mos (LMM_) and Lipa Mdogo Mdogo (LMX_): tenants pay rent in small instalments, PAY credits the landlord and
+ * settles by Paystack transfer. Everything below is stored in MINOR UNITS (cents) with epoch-millisecond timestamps.
+ */
+const minor = (v: unknown): number | null => {
+  const n = num(v);
+  return n === null ? null : Math.round(n);
+};
+
+function customer(prefix: string, v: unknown): string | null {
+  return typeof v === "string" && v ? `${prefix}${v}` : null;
+}
+
+/** LMM_ instalment: the tenant pays credit + a surcharge. The company keeps the surcharge less the Paystack fee (keptMinor). */
+export const lmmInstalmentAdapter: PayAdapter = {
+  id: "lmm_instalment",
+  platform: "pms",
+  async load(reader, w) {
+    const docs = await reader.queryRange({
+      source: "default", collection: "lmm_payments", timeField: "createdAt", timeType: "epochMs", startMs: w.startMs, endMs: w.endMs,
+      select: ["status", "chargeMinor", "creditMinor", "surchargeMinor", "paystackFeeMinor", "keptMinor", "createdAt", "creditedAt", "agentId", "tenantId"],
+    });
+    return docs.map((rec: DocRecord): PaymentFact | null => {
+      const d = rec.data;
+      const createdAtMs = toMillis(d.createdAt);
+      if (createdAtMs === null) return null;
+      const status = statusOf(d.status);
+      const ok = status === "success";
+      const charge = minor(d.chargeMinor) ?? 0;
+      const surcharge = minor(d.surchargeMinor) ?? 0;
+      const fee = minor(d.paystackFeeMinor);
+      const kept = minor(d.keptMinor);
+      return {
+        reference: rec.id, chargeType: "lmm_instalment", platform: "pms", stream: STREAM_BY_CHARGE_TYPE.lmm_instalment, status, createdAtMs,
+        settledAtMs: status === "pending" ? null : toMillis(d.creditedAt),
+        gmvCents: charge, gatewayFeeCents: ok ? fee : null,
+        platformRevenueCents: ok ? surcharge : 0, passThroughCents: 0,
+        netRevenueCents: ok ? (kept ?? surcharge - (fee ?? 0)) : 0,
+        basis: kept !== null ? "recorded" : "gross_fee_unknown",
+        customerRef: customer("pms:user:", d.agentId),
+      };
+    }).filter((f): f is PaymentFact => f !== null);
+  },
+};
+
+/**
+ * LMX_ instalment: the tenant pays credit + reserve (transfer-cost cover) + a tiered service fee. The desk agent keeps a share
+ * of the service fee. Revenue = service fee + reserve; pass-through = desk share; net = revenue - desk share - Paystack fee.
+ * The real transfer cost is booked later by the lmx_transfers adapter, so the reserve is not double counted.
+ */
+export const lmxInstalmentAdapter: PayAdapter = {
+  id: "lmx_instalment",
+  platform: "pms",
+  async load(reader, w) {
+    const docs = await reader.queryRange({
+      source: "default", collection: "lmmx_payments", timeField: "createdAt", timeType: "epochMs", startMs: w.startMs, endMs: w.endMs,
+      select: ["status", "chargeMinor", "reserveMinor", "serviceMinor", "deskShareMinor", "paystackFeeMinor", "createdAt", "creditedAt", "tenantId"],
+    });
+    return docs.map((rec: DocRecord): PaymentFact | null => {
+      const d = rec.data;
+      const createdAtMs = toMillis(d.createdAt);
+      if (createdAtMs === null) return null;
+      const status = statusOf(d.status);
+      const ok = status === "success";
+      const service = minor(d.serviceMinor) ?? 0;
+      const reserve = minor(d.reserveMinor) ?? 0;
+      const desk = minor(d.deskShareMinor) ?? 0;
+      const fee = minor(d.paystackFeeMinor);
+      return {
+        reference: rec.id, chargeType: "lmx_instalment", platform: "pms", stream: STREAM_BY_CHARGE_TYPE.lmx_instalment, status, createdAtMs,
+        settledAtMs: status === "pending" ? null : toMillis(d.creditedAt),
+        gmvCents: minor(d.chargeMinor) ?? 0, gatewayFeeCents: ok ? fee : null,
+        platformRevenueCents: ok ? service + reserve : 0, passThroughCents: ok ? desk : 0,
+        netRevenueCents: ok ? service + reserve - desk - (fee ?? 0) : 0,
+        basis: fee !== null ? "recorded" : "gross_fee_unknown",
+        customerRef: customer("pms:tenant:", d.tenantId),
+      };
+    }).filter((f): f is PaymentFact => f !== null);
+  },
+};
+
+/**
+ * LMM landlord settlements (`lmm_settlements`, transfers in chunks). The landlord-borne transfer fee is revenue; the Paystack
+ * transfer cost is the gateway cost. Only successful chunks count, and only as revenue lines (the money moved is the landlord's,
+ * already counted in the instalment GMV).
+ */
+export const lmmSettlementAdapter: PayAdapter = {
+  id: "lmm_settlement",
+  platform: "pms",
+  async load(reader, w) {
+    const docs = await reader.queryRange({
+      source: "default", collection: "lmm_settlements", timeField: "createdAt", timeType: "epochMs", startMs: w.startMs, endMs: w.endMs,
+      select: ["chunks", "agentId", "createdAt"],
+    });
+    const facts: PaymentFact[] = [];
+    for (const rec of docs) {
+      const createdAtMs = toMillis(rec.data.createdAt) ?? w.startMs;
+      const chunks = Array.isArray(rec.data.chunks) ? rec.data.chunks : [];
+      let fee = 0;
+      let cost = 0;
+      for (const c of chunks) {
+        if (!c || typeof c !== "object") continue;
+        const ch = c as Record<string, unknown>;
+        if (statusOf(ch.status) !== "success") continue;
+        fee += minor(ch.feeMinor) ?? 0;
+        cost += minor(ch.paystackCostMinor) ?? 0;
+      }
+      if (fee === 0 && cost === 0) continue;
+      facts.push({
+        reference: rec.id, chargeType: "lmm_settlement", platform: "pms", stream: STREAM_BY_CHARGE_TYPE.lmm_settlement, status: "success",
+        createdAtMs, settledAtMs: null,
+        gmvCents: 0, gatewayFeeCents: cost, platformRevenueCents: fee, passThroughCents: 0, netRevenueCents: fee - cost,
+        basis: "recorded", customerRef: customer("pms:user:", rec.data.agentId), revenueOnly: true,
+      });
+    }
+    return facts;
+  },
+};
+
+/**
+ * LMX ledger lines that are not tied to a checkout: `payout_fee` (the real Paystack transfer cost, negative) and
+ * `withdraw_service` (the tenant withdrawal service fee, positive). Read from `lmmx_ledger`, written by PAY at the time.
+ */
+async function ledgerFacts(
+  reader: Parameters<PayAdapter["load"]>[0], w: { startMs: number; endMs: number }, type: "payout_fee" | "withdraw_service"
+): Promise<PaymentFact[]> {
+  const docs = await reader.queryRange({
+    source: "default", collection: "lmmx_ledger", timeField: "createdAt", timeType: "epochMs", startMs: w.startMs, endMs: w.endMs,
+    select: ["type", "amountMinor", "tenantId", "createdAt"],
+  });
+  const facts: PaymentFact[] = [];
+  for (const rec of docs) {
+    if (get(rec.data, "type") !== type) continue;
+    const createdAtMs = toMillis(rec.data.createdAt);
+    if (createdAtMs === null) continue;
+    const amount = minor(rec.data.amountMinor) ?? 0;
+    const isCost = type === "payout_fee";
+    facts.push({
+      reference: rec.id, chargeType: isCost ? "lmx_transfers" : "lmx_withdrawals", platform: "pms",
+      stream: isCost ? STREAM_BY_CHARGE_TYPE.lmx_transfers : STREAM_BY_CHARGE_TYPE.lmx_withdrawals, status: "success", createdAtMs, settledAtMs: null,
+      gmvCents: 0, gatewayFeeCents: isCost ? amount : null, platformRevenueCents: isCost ? 0 : amount, passThroughCents: 0,
+      netRevenueCents: isCost ? -amount : amount, basis: "ledger", customerRef: customer("pms:tenant:", rec.data.tenantId), revenueOnly: true,
+    });
+  }
+  return facts;
+}
+
+export const lmxTransfersAdapter: PayAdapter = { id: "lmx_transfers", platform: "pms", load: (r, w) => ledgerFacts(r, w, "payout_fee") };
+export const lmxWithdrawalsAdapter: PayAdapter = { id: "lmx_withdrawals", platform: "pms", load: (r, w) => ledgerFacts(r, w, "withdraw_service") };
