+import { createCyberCollector, snapshotCyber } from "../src/collectors/cyber";
+import { MemoryKpiStore } from "../src/core/store";
+import { runDays } from "../src/jobs/run";
+import { dailyPeriod } from "../src/core/period";
+import { KpiValue } from "../src/core/types";
+import { DocRecord } from "../src/core/reader";
+
+const ts = (ms: number) => ({ toMillis: () => ms });
+const find = (v: KpiValue[], id: string, grain = "daily", dims: Record<string, string> = {}) =>
+  v.find((x) => x.kpiId === id && x.grain === grain && JSON.stringify(x.dimensions) === JSON.stringify(dims));
+const rec = (path: string, data: Record<string, unknown>): DocRecord => ({ id: path.split("/").pop()!, path, data });
+
+describe("rent under the convenience-fee model", () => {
+  const txn = {
+    status: "success", userId: "u1", createdAt: ts(T_DAY), completedAt: ts(T_DAY + 1000),
+    chargeMinor: 100500, netPayoutMinor: 98050, agentMinor: 200, paystackFeeMinor: 1507, platformKeptMinor: 743,
+    paystackResponse: { amount: 100500, fees: 1507 },
+  };
+
+  it("uses the books PAY recorded: kept money is net, the agent share is pass-through", async () => {
+    const r = new MemoryPayReader().add("default", "transactions/INV_1", txn);
+    const [f] = await pmsRentAdapter.load(r, DAY_WINDOW);
+    expect(f).toMatchObject({ gmvCents: 100500, platformRevenueCents: 2450, passThroughCents: 200, gatewayFeeCents: 1507, netRevenueCents: 743, basis: "recorded" });
+  });
+
+  it("needs no user or account lookups when the books are recorded", async () => {
+    const r = new MemoryPayReader().add("default", "transactions/INV_1", txn);
+    let lookups = 0;
+    const orig = r.getDocs.bind(r);
+    r.getDocs = async (...a) => { lookups++; return orig(...a); };
+    await pmsRentAdapter.load(r, DAY_WINDOW);
+    expect(lookups).toBe(0);
+  });
+});
+
+describe("Lipa Mos Mos and Lipa Mdogo Mdogo", () => {
+  it("LMM instalment: revenue is the surcharge, net is what PAY kept; failed and pending earn nothing", async () => {
+    const r = new MemoryPayReader()
+      .add("default", "lmm_payments/LMM_1", { status: "credited", chargeMinor: 20500, creditMinor: 20000, surchargeMinor: 500, paystackFeeMinor: 300, keptMinor: 200, createdAt: T_DAY, agentId: "a1" })
+      .add("default", "lmm_payments/LMM_2", { status: "rejected_amount", chargeMinor: 20500, createdAt: T_DAY })
+      .add("default", "lmm_payments/LMM_3", { status: "pending", chargeMinor: 1000, createdAt: T_DAY });
+    const facts = await lmmInstalmentAdapter.load(r, DAY_WINDOW);
+    const ok = facts.find((f) => f.reference === "LMM_1")!;
+    expect(ok).toMatchObject({ status: "success", stream: "instalments", gmvCents: 20500, platformRevenueCents: 500, gatewayFeeCents: 300, netRevenueCents: 200, basis: "recorded" });
+    expect(facts.find((f) => f.reference === "LMM_2")).toMatchObject({ status: "failed", netRevenueCents: 0 });
+    expect(facts.find((f) => f.reference === "LMM_3")).toMatchObject({ status: "pending", netRevenueCents: 0 });
+  });
+
+  it("LMX instalment: revenue = service fee + reserve, desk share passes through, net after Paystack fee", async () => {
+    const r = new MemoryPayReader().add("default", "lmmx_payments/LMX_1", { status: "credited", chargeMinor: 21000, serviceMinor: 400, reserveMinor: 150, deskShareMinor: 300, paystackFeeMinor: 50, createdAt: T_DAY, tenantId: "t1" });
+    const [f] = await lmxInstalmentAdapter.load(r, DAY_WINDOW);
+    expect(f).toMatchObject({ stream: "instalments", gmvCents: 21000, platformRevenueCents: 550, passThroughCents: 300, gatewayFeeCents: 50, netRevenueCents: 200 });
+  });
+
+  it("LMM settlement: fee minus Paystack transfer cost over successful chunks, as a revenue-only line", async () => {
+    const r = new MemoryPayReader()
+      .add("default", "lmm_settlements/S1", { createdAt: T_DAY, chunks: [{ status: "success", feeMinor: 1000, paystackCostMinor: 600 }, { status: "failed", feeMinor: 999, paystackCostMinor: 999 }] })
+      .add("default", "lmm_settlements/S2", { createdAt: T_DAY, chunks: [{ status: "failed", feeMinor: 500, paystackCostMinor: 100 }] });
+    const facts = await lmmSettlementAdapter.load(r, DAY_WINDOW);
+    expect(facts).toHaveLength(1);
+    expect(facts[0]).toMatchObject({ stream: "transfers", platformRevenueCents: 1000, gatewayFeeCents: 600, netRevenueCents: 400, gmvCents: 0, revenueOnly: true });
+  });
+
+  it("LMX ledger: payout fee is a cost, withdraw service is revenue, everything else is ignored", async () => {
+    const r = new MemoryPayReader()
+      .add("default", "lmmx_ledger/a", { type: "payout_fee", amountMinor: 300, direction: "out", createdAt: T_DAY })
+      .add("default", "lmmx_ledger/b", { type: "withdraw_service", amountMinor: 150, direction: "in", createdAt: T_DAY })
+      .add("default", "lmmx_ledger/c", { type: "collect", amountMinor: 99999, direction: "in", createdAt: T_DAY })
+      .add("default", "lmmx_ledger/d", { type: "service_platform", amountMinor: 400, direction: "in", createdAt: T_DAY });
+    const [cost] = await lmxTransfersAdapter.load(r, DAY_WINDOW);
+    const [fee] = await lmxWithdrawalsAdapter.load(r, DAY_WINDOW);
+    expect(cost).toMatchObject({ stream: "transfers", gatewayFeeCents: 300, netRevenueCents: -300, revenueOnly: true });
+    expect(fee).toMatchObject({ stream: "withdrawals", platformRevenueCents: 150, netRevenueCents: 150, revenueOnly: true });
+  });
+});
+
+describe("Landlord Watch and compliance reports", () => {
+  it("read their own types from platform_revenue and ignore the rest", async () => {
+    const r = new MemoryPayReader()
+      .add("default", "platform_revenue/R1", { type: "landlord_watch_transcript", grossAmount: 99, paystackFees: 2, netRevenue: 97, createdAt: ts(T_DAY) })
+      .add("default", "platform_revenue/R2", { type: "compliance_report", grossAmount: 200, paystackFees: 4, netRevenue: 196, createdAt: ts(T_DAY) })
+      .add("default", "platform_revenue/R3", { type: "report_charge", grossAmount: 50, netRevenue: 49, createdAt: ts(T_DAY) });
